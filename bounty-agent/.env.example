# Anthropic — required for all agents
ANTHROPIC_API_KEY=sk-ant-...

# HackerOne API — get from https://hackerone.com/settings/api_token/edit
H1_USERNAME=your_h1_username
H1_API_TOKEN=your_h1_api_token

# Shannon path (defaults to ~/shannon)
SHANNON_HOME=/root/shannon

# Hunt tuning
MAX_HUNT_COST_USD=30
MIN_BOUNTY_USD=100
HUNT_COOLDOWN_HOURS=6
