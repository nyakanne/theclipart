# Vindica frontend serverless deployment
#
# Safe to expose in the browser. Do not put provider/API secrets here.

# API origin. Use same-origin /api/v1 when the frontend platform rewrites /api
# to the backend, or use an API subdomain such as https://api.vindica.me/api/v1.
VITE_API_BASE_URL=https://vindica.me/api/v1

# Supabase browser auth configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy fallback only for older Supabase projects.
VITE_SUPABASE_ANON_KEY=
