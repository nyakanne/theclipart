# Copy to .env.local for local development
# In Netlify: Site settings → Environment variables
# In Docker: VITE_API_URL is set to "" at build time (see docker-compose.yml)

# API base URL
# - Leave empty ("") when running behind nginx (Docker / VPS) — frontend uses relative /api paths
# - Set to full URL for standalone deployments (Netlify, Railway, etc.)
VITE_API_URL=

# Supabase (Netlify deployments only — not used when running with Docker backend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Datadog RUM — create at app.us3.datadoghq.com → UX Monitoring → RUM Applications → New Application
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=us3.datadoghq.com
VITE_DD_ENV=staging
