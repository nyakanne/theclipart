# Copy to .env.local for local development
# In Netlify: Site settings → Environment variables

# URL of your deployed backend (Railway / Render / Fly.io)
# Leave empty to use Vite's local proxy (localhost:8000)
VITE_API_URL=https://api.yourdomain.com

# Your Google OAuth Client ID (public — safe to expose in frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Datadog RUM — create at app.us3.datadoghq.com → UX Monitoring → RUM Applications → New Application
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=us3.datadoghq.com
VITE_DD_ENV=staging
