# ─────────────────────────────────────────────────────────────────────────────
# DataGuard — backend environment template
#
# Copy to backend/.env and fill in real values.
# NEVER commit .env to version control — it is already in .gitignore.
# Generate SECRET_KEY:  python backend/scripts/generate_key.py
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production

# Production domain (no trailing slash).
# Docker/VPS: https://yourdomain.com
# Netlify:    https://yoursite.netlify.app
FRONTEND_URL=https://yourdomain.com

# Allowed CORS origins. Must match FRONTEND_URL in production.
# Use a JSON array for multiple: ["https://yourdomain.com","https://www.yourdomain.com"]
CORS_ORIGINS=https://yourdomain.com

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Must be 64+ chars. Run: python backend/scripts/generate_key.py
SECRET_KEY=REPLACE_ME_run_python_backend_scripts_generate_key_py

# Postgres password — also used by docker-compose to create the DB user.
POSTGRES_PASSWORD=REPLACE_ME_strong_random_password

# Redis requirepass — also used by docker-compose.
REDIS_PASSWORD=REPLACE_ME_strong_random_password

# Flower monitoring UI credentials.
FLOWER_USER=admin
FLOWER_PASSWORD=REPLACE_ME_flower_password

# ── Database ──────────────────────────────────────────────────────────────────
# docker-compose builds this from POSTGRES_PASSWORD. Override only when using
# an external Postgres (RDS, Supabase pooler, etc.).
# DATABASE_URL=postgresql+asyncpg://dataguard:PASSWORD@postgres:5432/dataguard
# SYNC_DATABASE_URL=postgresql://dataguard:PASSWORD@postgres:5432/dataguard

# ── Redis ─────────────────────────────────────────────────────────────────────
# docker-compose builds this from REDIS_PASSWORD. Override for external Redis.
# REDIS_URL=redis://:PASSWORD@redis:6379/0

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Required for both Docker/VPS and Netlify deployments.
# Create at: github.com → Settings → Developer settings → OAuth Apps → New OAuth App
#
# Docker/VPS callback: https://yourdomain.com/api/v1/auth/github/callback
# Netlify callback:    https://yoursite.netlify.app/api/v1/auth/github/callback
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
GITHUB_REDIRECT_URI=https://yourdomain.com/api/v1/auth/github/callback

# ── Google OAuth (optional — Docker/VPS path only) ───────────────────────────
# Only needed if you also want Google login via the FastAPI backend.
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Prefer instance roles in production (leave blank). Use only for local testing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: pull all secrets from AWS Secrets Manager at startup.
# Create a secret named e.g. "dataguard/production" with keys matching this file.
AWS_SECRETS_MANAGER_NAME=

# S3 bucket for scan artefacts and report exports.
S3_BUCKET=dataguard-artefacts

# KMS key ARN for envelope encryption. REQUIRED in production (APP_ENV=production).
KMS_KEY_ID=

# SES verified sender address for DSAR/opt-out emails.
SES_FROM_EMAIL=noreply@yourdomain.com

# ── Third-party APIs ──────────────────────────────────────────────────────────
# Have I Been Pwned — paid API key for breach lookups.
# Get one at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Honey-token domain (canary token listener).
HONEY_DOMAIN=honey.yourdomain.com

# Mailgun API key (used for opt-out request emails).
MAILGUN_API_KEY=

# ── Scanning ──────────────────────────────────────────────────────────────────
MAX_CONCURRENT_PLAYWRIGHT=5
SCAN_TIMEOUT_SECONDS=300
BROKER_LIST_PATH=/app/data/brokers.json

# ── Opt-out automation ────────────────────────────────────────────────────────
# Keep false until:
#   1. SES domain verification is complete
#   2. Removal email delivery tested end-to-end to a real inbox
#   3. SES account is out of sandbox mode
ALLOW_REAL_OPT_OUTS=false

# ── Datadog APM ───────────────────────────────────────────────────────────────
# Get from: app.datadoghq.com → Organization Settings → API Keys
DD_API_KEY=
DD_SITE=us3.datadoghq.com
DD_ENV=production
DD_VERSION=1.0.0

# ── Datadog RUM (frontend) ────────────────────────────────────────────────────
# Get from: app.datadoghq.com → UX Monitoring → RUM Applications → New Application
# These are passed as Docker build args to the frontend image.
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=us3.datadoghq.com
VITE_DD_ENV=production
