# App
APP_ENV=development
DEMO_MODE=false
SECRET_KEY=change-me-32-chars-minimum-please
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
REQUIRE_AUTH=false

# Supabase Auth JWT verification.
# Use SUPABASE_JWKS_URL for the current JWT signing-key system.
# Use SUPABASE_JWT_SECRET only for legacy Supabase projects that still expose it.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Postgres
DATABASE_URL=postgresql+asyncpg://dataguard:secret@postgres:5432/dataguard
SYNC_DATABASE_URL=postgresql://dataguard:secret@postgres:5432/dataguard

# Redis
REDIS_URL=redis://redis:6379/0

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=dataguard-artefacts
KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT:key/KEY_ID
REPORT_STORAGE_DIR=/tmp/vindica-reports
SES_FROM_EMAIL=noreply@vindica.me
ALLOW_REAL_OPT_OUTS=false

# HIBP
HIBP_API_KEY=

# IP enrichment
IPINFO_TOKEN=
IPINFO_BASE_URL=https://api.ipinfo.io/lite

# Azure Computer Vision
# Get Endpoint + Key from Azure Portal -> your Azure AI resource -> Keys and Endpoint
AZURE_COMPUTER_VISION_ENDPOINT=
AZURE_COMPUTER_VISION_KEY=
AZURE_CV_ENDPOINT=
AZURE_CV_KEY=
AZURE_COMPUTER_VISION_API_VERSION=v3.2
AZURE_COMPUTER_VISION_VISUAL_FEATURES=Description,Tags,Categories,Objects
AZURE_COMPUTER_VISION_TIMEOUT_SECONDS=20
AZURE_COMPUTER_VISION_MAX_UPLOAD_BYTES=5242880

# Google Cloud Vision
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_VISION_BASE_URL=https://vision.googleapis.com/v1/images:annotate
GOOGLE_CLOUD_VISION_FEATURES=LABEL_DETECTION,OBJECT_LOCALIZATION,SAFE_SEARCH_DETECTION,WEB_DETECTION
GOOGLE_CLOUD_VISION_MAX_RESULTS=10
GOOGLE_CLOUD_VISION_TIMEOUT_SECONDS=20

# Hugging Face Inference
HUGGINGFACE_API_KEY=
HF_TOKEN=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models
HUGGINGFACE_IMAGE_CAPTION_MODEL=Salesforce/blip-image-captioning-large
HUGGINGFACE_OBJECT_DETECTION_MODEL=facebook/detr-resnet-50
HUGGINGFACE_IMAGE_CLASSIFICATION_MODEL=google/vit-base-patch16-224
HUGGINGFACE_NSFW_MODEL=Falconsai/nsfw_image_detection
HUGGINGFACE_TIMEOUT_SECONDS=25
HUGGINGFACE_MAX_LABELS=10

# Brave Search
BRAVE_SEARCH_API_KEY=
BRAVE_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_COUNTRY=US
BRAVE_SEARCH_SEARCH_LANG=en
BRAVE_SEARCH_SAFESEARCH=moderate
BRAVE_SEARCH_TIMEOUT_SECONDS=12
BRAVE_SEARCH_MAX_RESULTS=5
BRAVE_SEARCH_MAX_BROKER_QUERIES=3

# Honey-token catch-all domain (Mailgun)
HONEY_DOMAIN=honey.vindica.me
MAILGUN_API_KEY=

# Scanning settings
MAX_CONCURRENT_PLAYWRIGHT=5
SCAN_TIMEOUT_SECONDS=300
BROKER_LIST_PATH=/app/data/brokers.json

# Production HTTPS example
# APP_ENV=production
# REQUIRE_AUTH=true
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=<legacy Supabase JWT secret, only if not using JWKS>
# CORS_ORIGINS=https://vindica.me,https://www.vindica.me
# PUBLIC_APP_URL=https://vindica.me
# SES_FROM_EMAIL=noreply@vindica.me
# HONEY_DOMAIN=honey.vindica.me
