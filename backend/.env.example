# ─────────────────────────────────────────────────────────────────────────────
# DataGuard — environment template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Generate SECRET_KEY with:  python scripts/generate_key.py
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_ENV=development          # development | production
CORS_ORIGINS=http://localhost:3000

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Must be at least 64 chars. Run: python scripts/generate_key.py
SECRET_KEY=REPLACE_ME_run_python_scripts_generate_key_py

# Postgres — also used by docker-compose for POSTGRES_PASSWORD
POSTGRES_PASSWORD=REPLACE_ME_strong_db_password

# Redis password (requirepass)
REDIS_PASSWORD=REPLACE_ME_strong_redis_password

# Flower admin UI
FLOWER_USER=admin
FLOWER_PASSWORD=REPLACE_ME_flower_password

# ── Database ─────────────────────────────────────────────────────────────────
# Injected by docker-compose from POSTGRES_PASSWORD above.
# Override here if using an external RDS instance.
# DATABASE_URL=postgresql+asyncpg://dataguard:PASSWORD@postgres:5432/dataguard
# SYNC_DATABASE_URL=postgresql://dataguard:PASSWORD@postgres:5432/dataguard

# ── Redis ────────────────────────────────────────────────────────────────────
# Injected by docker-compose. Override for external ElastiCache.
# REDIS_URL=redis://:PASSWORD@redis:6379/0

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# In production, prefer instance roles (leave blank) or use Secrets Manager.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: pull all secrets from AWS Secrets Manager at startup.
# Create a secret named "dataguard/production" with keys matching this file.
AWS_SECRETS_MANAGER_NAME=

S3_BUCKET=dataguard-artefacts
KMS_KEY_ID=
SES_FROM_EMAIL=noreply@dataguard.example.com

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create at github.com → Settings → Developer settings → OAuth Apps → New OAuth App
# Callback URL: https://your-site.netlify.app/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://your-site.netlify.app/api/v1/auth/github/callback
FRONTEND_URL=https://your-site.netlify.app

# ── Third-party APIs ─────────────────────────────────────────────────────────
HIBP_API_KEY=
HONEY_DOMAIN=honey.dataguard.example.com
MAILGUN_API_KEY=

# ── Scanning ─────────────────────────────────────────────────────────────────
MAX_CONCURRENT_PLAYWRIGHT=5
SCAN_TIMEOUT_SECONDS=300
BROKER_LIST_PATH=/app/data/brokers.json

# ── Opt-out automation ────────────────────────────────────────────────────────
# Set to true ONLY after SES domain verification is complete and removal
# email delivery has been tested end-to-end. Defaults to false (manual links only).
ALLOW_REAL_OPT_OUTS=false

# ── Datadog APM / RUM ─────────────────────────────────────────────────────────
DD_API_KEY=
DD_SITE=us3.datadoghq.com
DD_ENV=staging
# Frontend RUM — create at app.us3.datadoghq.com → UX Monitoring → RUM Applications
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=us3.datadoghq.com
VITE_DD_ENV=staging

# ── Production domain ─────────────────────────────────────────────────────────
# Used by nginx CORS and OAuth redirects in production
DOMAIN=dataguarddog.netlify.app
