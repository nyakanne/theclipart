# Vindica backend serverless/managed-runtime deployment
#
# Server-only. Never commit real values or copy these into frontend env vars.

# Runtime
APP_ENV=production
DEMO_MODE=false
SERVERLESS_PLATFORM=cloud-run
PUBLIC_APP_URL=https://vindica.me
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
REQUIRE_AUTH=true
CORS_ORIGINS=["https://vindica.me","https://www.vindica.me"]
ALLOWED_HOSTS=["vindica.me","www.vindica.me","api.vindica.me","localhost","127.0.0.1"]

# Supabase JWT verification
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Managed Postgres. Use the async URL for the API and sync URL for Alembic/worker code.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
SYNC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?ssl=require

# Managed Redis / rate limit cache. Upstash Redis TCP URL or another managed Redis URL.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
QUEUE_BACKEND=upstash-redis

# Object storage for report/evidence artifacts.
# Supported readiness labels today: local, s3, r2, vercel_blob.
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=vindica-artifacts
OBJECT_STORAGE_ENDPOINT=
S3_BUCKET=vindica-artifacts
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BLOB_READ_WRITE_TOKEN=

# Encryption
KMS_KEY_ID=
REQUIRE_KMS_IN_PRODUCTION=true

# Email / opt-out delivery. Keep ALLOW_REAL_OPT_OUTS=false until verified contacts
# and sender/domain verification are complete.
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=noreply@vindica.me
RESEND_API_KEY=
MAILGUN_API_KEY=
ALLOW_REAL_OPT_OUTS=false
BROKER_PRIVACY_EMAILS={}

# Provider keys. Server-side only.
BRAVE_SEARCH_API_KEY=
BRAVE_API_KEY=
HIBP_API_KEY=
IPINFO_TOKEN=
HF_TOKEN=
HUGGINGFACE_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
AZURE_CV_ENDPOINT=
AZURE_CV_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# Abuse and provider-cost protection
MAX_ACTIVE_SCANS_PER_USER=2
API_REQUESTS_PER_5_MINUTES=300
SCANS_PER_DAY=10
EXPENSIVE_LOOKUPS_PER_HOUR=30
IMAGE_ANALYSES_PER_DAY=10
MAX_REMOTE_IMAGE_BYTES=5242880
MAX_REQUEST_BODY_BYTES=10485760
RUN_SCANS_INLINE=false
