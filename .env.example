# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-char-string

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://brain:secret@localhost:5432/secondbrain
SYNC_DATABASE_URL=postgresql://brain:secret@localhost:5432/secondbrain

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI: Claude (required) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-5

# ── AI: Embeddings ────────────────────────────────────────────────────────────
# Provider: openai | local
EMBED_PROVIDER=openai
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-ada-002
EMBED_DIM=1536

# For local embeddings (no API key needed, 384 dims):
# EMBED_PROVIDER=local
# LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
# EMBED_DIM=384

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads

# ── Action Safety ─────────────────────────────────────────────────────────────
# Always true — agents NEVER execute external actions without approval
REQUIRE_APPROVAL=true
AUTO_APPROVE_LOW_RISK=false

# ── Scheduler ─────────────────────────────────────────────────────────────────
DAILY_BRIEFING_HOUR=7
DAILY_BRIEFING_MINUTE=0

# ── Voice: LiveKit ────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice: Twilio (fallback) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
